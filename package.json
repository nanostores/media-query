{
  "name": "@nanostores/media-query",
  "version": "0.1.2",
  "description": "A smart store for Nano Stores state manager to sync with some media query",
  "keywords": [
    "media",
    "nano",
    "preact",
    "query",
    "react",
    "store",
    "svelte",
    "vue"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "nanostores/media-query",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test:lint": "oxlint .",
    "test:coverage": "pnpm bnt --coverage 100 --coverage-exclude 'test/*'",
    "test:size": "size-limit",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^0.2.2",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@types/node": "^25.5.0",
    "actions-up": "^1.12.0",
    "better-node-test": "^0.8.4",
    "clean-publish": "^6.0.5",
    "multiocular": "^0.8.2",
    "nanodelay": "^2.0.2",
    "nanostores": "^1.2.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.18.1",
    "size-limit": "^12.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "nanostores": "^0.9.0 || ^0.10.0 || ^0.11.0 || ^1.0.0"
  },
  "size-limit": [
    {
      "import": {
        "./index.js": "{ fromMediaQuery }"
      },
      "limit": "96 B"
    }
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >= 24.0.0"
  },
  "clean-publish": {
    "cleanDocs": true
  }
}
